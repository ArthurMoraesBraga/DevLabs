@startuml pacotes
title Sistema de Aluguel de Carros - Diagrama de Pacotes (Visão Lógica)
skinparam packageStyle folder

package "Subsistema: Construção dinâmica das páginas web\n(frontend - React + Vite)" as FE {
  package "pages" as fe_pages
  package "components" as fe_components
  package "context" as fe_context
  package "services" as fe_services
  package "utils" as fe_utils
}

package "Subsistema: Gestão de pedidos e contratos\n(backend - Spring Boot, MVC)" as BE {
  package "controller" as be_controller
  package "dto" as be_dto
  package "service" as be_service
  package "model" as be_model
  package "repository" as be_repository
  package "security" as be_security
  package "config" as be_config
  package "exception" as be_exception
}

database "Persistência\n(hoje: memória / futuro: Supabase PostgreSQL)" as DB

fe_pages ..> fe_components
fe_pages ..> fe_context
fe_pages ..> fe_services
fe_pages ..> fe_utils
fe_context ..> fe_services

fe_services ..> be_controller : HTTP/JSON (REST)\nAuthorization: Bearer token

be_controller ..> be_dto
be_controller ..> be_service
be_dto ..> be_model
be_service ..> be_model
be_service ..> be_repository
be_service ..> be_exception
be_repository ..> be_model
be_repository ..> DB
be_security ..> be_repository
be_config ..> be_security
be_config ..> be_service
be_model ..> be_exception
@enduml
