# ------------------------------------------------------------------
# Modelo de configuração local do banco Supabase (PostgreSQL).
#
# Copie este arquivo para "application-local.properties" (mesma pasta)
# e preencha com as credenciais reais do seu projeto Supabase.
# O arquivo "application-local.properties" é ignorado pelo Git.
#
# Onde encontrar: painel do Supabase > Project Settings > Database >
# Connection string (modo "Session pooler" ou "Transaction pooler").
# ------------------------------------------------------------------
spring.datasource.url=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres
spring.datasource.username=postgres.SEU_PROJECT_REF
spring.datasource.password=SUA_SENHA_DO_BANCO
