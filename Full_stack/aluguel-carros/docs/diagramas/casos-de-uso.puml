@startuml casos-de-uso
title Sistema de Aluguel de Carros - Diagrama de Casos de Uso
left to right direction
skinparam packageStyle rectangle

actor "Usuário" as Usuario
actor "Cliente" as Cliente
actor "Agente" as Agente
actor "Empresa" as Empresa
actor "Banco" as Banco

Usuario <|-- Cliente
Usuario <|-- Agente
Agente <|-- Empresa
Agente <|-- Banco

rectangle "Sistema de Aluguel de Carros" {
  usecase "Realizar cadastro" as UC01
  usecase "Efetuar login" as UC02
  usecase "Efetuar logout" as UC03

  usecase "Manter cadastro de cliente\n(CRUD)" as UC04
  usecase "Gerenciar rendimentos\n(máx. 3)" as UC05

  usecase "Introduzir pedido" as UC06
  usecase "Consultar pedidos / status" as UC07
  usecase "Modificar pedido" as UC08
  usecase "Cancelar pedido" as UC09

  usecase "Avaliar pedido\n(análise financeira)" as UC10
  usecase "Executar contrato" as UC11
  usecase "Conceder contrato de crédito" as UC12

  usecase "Manter automóveis" as UC13
  usecase "Consultar automóveis" as UC14
}

Usuario --> UC01
Usuario --> UC02
Usuario --> UC03
Usuario --> UC07
Usuario --> UC14

Cliente --> UC04
Cliente --> UC06
Cliente --> UC08
Cliente --> UC09

Agente --> UC04
Agente --> UC08
Agente --> UC10
Agente --> UC11
Agente --> UC13

Banco --> UC12

UC04 ..> UC05 : <<include>>
UC12 ..> UC11 : <<extend>>

note bottom of UC02
  Pré-condição de todos os casos de uso,
  exceto "Realizar cadastro".
end note
@enduml
