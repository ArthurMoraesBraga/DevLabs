@startuml classes-v1
title Sistema de Aluguel de Carros - Diagrama de Classes (Modelo) - v1 (versão inicial)
' VERSÃO INICIAL da modelagem, anterior à implementação da persistência.
' Diferenças para a v2 (atual): Automovel ainda NÃO possui o campo imagemUrl.
skinparam classAttributeIconSize 0
hide empty members

interface Identificavel {
  +getId(): Long
  +setId(id: Long): void
}

abstract class Usuario {
  -id: Long
  -login: String
  -senha: String
  -nome: String
  -endereco: String
  +{abstract} getPerfil(): Perfil
}

class Cliente {
  +{static} MAX_RENDIMENTOS: int = 3
  -rg: String
  -cpf: String
  -profissao: String
  +setRendimentos(lista: List<Rendimento>): void
  +getRendaTotal(): BigDecimal
}

class Rendimento {
  -entidadeEmpregadora: String
  -valor: BigDecimal
}

abstract class Agente {
  -cnpj: String
}

class Empresa
class Banco

class Automovel {
  -id: Long
  -matricula: String
  -ano: Integer
  -marca: String
  -modelo: String
  -placa: String
  -tipoProprietario: TipoProprietario
  -proprietarioId: Long
}

class PedidoAluguel {
  -id: Long
  -dataInicio: LocalDate
  -dataFim: LocalDate
  -status: StatusPedido
  -parecer: String
  -dataCriacao: LocalDateTime
  +definirPeriodo(inicio, fim): void
  +conflitaCom(inicio, fim): boolean
  +validarModificacaoPeloCliente(): void
  +validarModificacaoPeloAgente(): void
  +cancelar(): void
  +avaliar(agente: Agente, aprovado: boolean, parecer: String): void
  +executarContrato(contrato: Contrato): void
}

class Contrato {
  -id: Long
  -pedidoId: Long
  -tipoProprietario: TipoProprietario
  -dataAssinatura: LocalDate
}

class ContratoCredito {
  -valor: BigDecimal
  -taxaJurosMensal: BigDecimal
  -prazoMeses: Integer
}

enum Perfil {
  CLIENTE
  EMPRESA
  BANCO
  +isAgente(): boolean
}

enum StatusPedido {
  PENDENTE
  APROVADO
  REPROVADO
  CANCELADO
  CONTRATADO
  +isAtivo(): boolean
}

enum TipoProprietario {
  CLIENTE
  EMPRESA
  BANCO
}

Identificavel <|.. Usuario
Identificavel <|.. Automovel
Identificavel <|.. PedidoAluguel
Identificavel <|.. Contrato

Usuario <|-- Cliente
Usuario <|-- Agente
Agente <|-- Empresa
Agente <|-- Banco

Cliente "1" *-- "0..3" Rendimento : possui >
PedidoAluguel "*" --> "1" Cliente : solicitado por >
PedidoAluguel "*" --> "1" Automovel : refere-se a >
PedidoAluguel "*" --> "0..1" Agente : avaliado por >
PedidoAluguel "1" --> "0..1" Contrato : gera >
Contrato "1" *-- "0..1" ContratoCredito : associado a >
ContratoCredito "*" --> "1" Banco : concedido por >

Usuario ..> Perfil
PedidoAluguel ..> StatusPedido
Automovel ..> TipoProprietario
Contrato ..> TipoProprietario
@enduml
